 %!PS-Adobe-2.0
 %%Creator: Linkin Crouch
 %%PageOrder: Ascend
 %%BoundingBox: 0 0 500 842
 /CourierRegular 20 selectfont 
 290 770 moveto
 (-1-) show %Page Number
 /CourierRegular 35 selectfont 
 15 710 moveto
 /CourierRegular 11 selectfont 
 89 781 moveto
 (RGB NOVA Type-1 Document) show %Document type [KEY: Color, Style, Style type]
 /CourierRegular 35 selectfont 
 15 710 moveto
 (TITLE) show %Title text
 newpath %Line detail to seperate header from body text
	4 700 moveto
	550 700 lineto
 stroke
 % Colored bars
 1 0 0 setrgbcolor
 newpath
	30 800 moveto
	30 740 lineto
    45 740 lineto
    45 800 lineto
    30 800 lineto
 fill
 0 1 0 setrgbcolor
 newpath
	50 800 moveto
	50 740 lineto
    65 740 lineto
    65 800 lineto
    50 800 lineto
 fill
 0 0 1 setrgbcolor
 newpath
	70 800 moveto
	70 740 lineto
    85 740 lineto
    85 800 lineto
    70 800 lineto
 fill
 showpage             % print all on the page
